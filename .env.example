# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不会进仓库
# 服务端口（云主机/PaaS 常由平台注入，本地默认 8000）
PORT=8000

# JWT 签名密钥：上线务必替换为随机长字符串，留空则使用演示密钥
JWT_SECRET_KEY=change-this-to-a-random-secret

# 可选 LLM 增强：留空则用本地 RAG 检索，无需大模型密钥
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
# LLM_MODEL=deepseek-chat
